# Supabase Configuration
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase credentials (for daily email cron job)
# Service role key is in Supabase dashboard: Settings > API > service_role secret
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email provider (Resend) for daily spending reports
# Sign up at resend.com, verify a domain, and create an API key
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=your-verified-sender@yourdomain.com

# Public URL of the app, used for the "Open Expense Tracker" button in split
# emails. Set this in Vercel too — without it the link falls back to the
# per-deployment vercel.app host, which is login-walled when deployment
# protection is on.
APP_URL=https://your-app.vercel.app
