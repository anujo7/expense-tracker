# Supabase Configuration
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase credentials (for daily email cron job)
# Service role key is in Supabase dashboard: Settings > API > service_role secret
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email provider (Resend) for daily spending reports
# Sign up at resend.com, verify a domain, and create an API key
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=your-verified-sender@yourdomain.com
